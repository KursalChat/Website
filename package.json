  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsgo",
    "check:watch": "svelte-check --tsgo --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "paper": "typst compile paper/kursal.typ static/kursal.pdf && echo 'Compiled paper!'",
    "generate-og": "bun assets/og/render.ts",
    "generate-dmg": "\"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" --headless=new --disable-gpu --hide-scrollbars --window-size=820,500 --screenshot=mac-dmg-background.png assets/dmg.html && sips -s format jpeg mac-dmg-background.png --out mac-dmg-background.jpg && rm mac-dmg-background.png && mv mac-dmg-background.jpg ../Kursal/assets"
  },
  "dependencies": {
    "@icons-pack/svelte-simple-icons": "^7.2.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.4.0",
    "lucide-svelte": "^1.0.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.2.2"
  },
  "private": true,
  "type": "module",
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
